@model List<RaceDay.MVC.Models.EnrolmentViewModel>
@{
    ViewData["Title"] = "Event Enrolments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold">Event Enrolments</h3>
    <a asp-controller="Events" asp-action="Index" class="btn btn-secondary">Back to Events</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No participants enrolled in this event yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Participant</th>
                    <th>Enrolled On</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="fw-semibold">@e.ParticipantName</td>
                        <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="badge @(e.Status == "Active" ? "bg-success" : "bg-secondary")">
                                @e.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}