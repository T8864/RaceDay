@{
    ViewData["Title"] = "Organiser Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Welcome back, @ViewBag.FirstName </h2>
            <p class="text-muted mb-0">Organiser Dashboard — manage your events, categories and results.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="fs-1 mb-3"> </div>
                    <h5 class="card-title">Events</h5>
                    <p class="card-text text-muted">Create, edit and manage your race events.</p>
                    <a asp-controller="Events" asp-action="Index" class="btn btn-danger w-100">Manage Events</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="fs-1 mb-3"> </div>
                    <h5 class="card-title">Categories</h5>
                    <p class="card-text text-muted">Manage race categories like Road, Trail, and Track.</p>
                    <a asp-controller="Categories" asp-action="Index" class="btn btn-danger w-100">Manage Categories</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="fs-1 mb-3"></div>
                    <h5 class="card-title">Results</h5>
                    <p class="card-text text-muted">Post and update race results for your events.</p>
                    <a asp-controller="Results" asp-action="Index" class="btn btn-danger w-100">Manage Results</a>
                </div>
            </div>
        </div>
    </div>
</div>