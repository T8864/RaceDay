@model List<RaceDay.MVC.Models.EventViewModel>
@{
    ViewData["Title"] = "Events";
    var role = Context.Session.GetString("Role");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold"> Events</h3>
    @if (role == "Organiser")
    {
        <a asp-action="Create" class="btn btn-danger">
            <i class="bi bi-plus-circle"></i> New Event
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No events found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Distance</th>
                    <th>Status</th>
                    <th>Spots</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    <tr>
                        <td class="fw-semibold">@ev.EventName</td>
                        <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@ev.Location</td>
                        <td>@ev.Distance km</td>
                        <td>
                            <span class="badge @(ev.Status == "Open" ? "bg-success" : ev.Status == "Full" ? "bg-warning text-dark" : "bg-secondary")">
                                @ev.Status
                            </span>
                        </td>
                        <td>@ev.MaxParticipants</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-secondary">View</a>
                            @if (role == "Organiser")
                            {
                                <a asp-action="Edit" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-primary ms-1">Edit</a>
                                <form asp-action="Delete" asp-route-id="@ev.EventID" method="post" class="d-inline ms-1"
                                      onsubmit="return confirm('Delete this event?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            }
                            @if (role == "Participant")
                            {
                                <a asp-controller="Enrolments" asp-action="Enrol" asp-route-eventId="@ev.EventID"
                                   class="btn btn-sm btn-danger ms-1">Enrol</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}