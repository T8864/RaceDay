@{
    ViewData["Title"] = "Participant Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Welcome back, @ViewBag.FirstName </h2>
            <p class="text-muted mb-0">Participant Dashboard — find events and track your progress.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="fs-1 mb-3"></div>
                    <h5 class="card-title">Browse Events</h5>
                    <p class="card-text text-muted">Find upcoming races and enrol today.</p>
                    <a asp-controller="Events" asp-action="Index" class="btn btn-danger w-100">View Events</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="fs-1 mb-3"> </div>
                    <h5 class="card-title">My Enrolments</h5>
                    <p class="card-text text-muted">View and manage your race enrolments.</p>
                    <a asp-controller="Enrolments" asp-action="MyEnrolments" class="btn btn-danger w-100">My Enrolments</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="fs-1 mb-3"> </div>
                    <h5 class="card-title">My Results</h5>
                    <p class="card-text text-muted">Check your race times and positions.</p>
                    <a asp-controller="Results" asp-action="MyResults" class="btn btn-danger w-100">My Results</a>
                </div>
            </div>
        </div>
    </div>
</div>