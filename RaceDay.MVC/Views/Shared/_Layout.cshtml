<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .navbar-brand span {
            color: #dc3545;
            font-weight: 800;
        }

        .navbar {
            border-bottom: 3px solid #dc3545;
        }

        body {
            background-color: #f8f9fa;
        }

        .footer {
            border-top: 2px solid #dee2e6;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
                     Race<span>Day</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        @{
                            var role = Context.Session.GetString("Role");
                            var isLoggedIn = !string.IsNullOrEmpty(role);
                        }
                        @if (isLoggedIn && role == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Events" asp-action="Index">Events</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Categories" asp-action="Index">Categories</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Results" asp-action="Index">Results</a>
                            </li>
                        }
                        @if (isLoggedIn && role == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Events" asp-action="Index">Browse Events</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Enrolments" asp-action="MyEnrolments">My Enrolments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Results" asp-action="MyResults">My Results</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-warning">
                                    <i class="bi bi-person-circle"></i>
                                    @Context.Session.GetString("FirstName") (@role)
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm ms-2">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="pb-4">
        <div class="container mt-3">
            @RenderBody()
        </div>
    </main>

    <footer class="footer mt-auto py-3 bg-white">
        <div class="container text-center text-muted small">
            &copy; @DateTime.Now.Year RaceDay — Race Event Management System
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>