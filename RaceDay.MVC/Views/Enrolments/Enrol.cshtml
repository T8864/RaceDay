@model RaceDay.MVC.Models.EventViewModel
@{
    ViewData["Title"] = "Enrol in Event";
}

<div class="card shadow-sm">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0">Enrol in Event</h4>
    </div>
    <div class="card-body p-4">
        <dl class="row">
            <dt class="col-sm-3">Event</dt>
            <dd class="col-sm-9 fw-semibold">@Model.EventName</dd>

            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.EventDate.ToString("dd MMMM yyyy HH:mm")</dd>

            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@Model.Location</dd>

            <dt class="col-sm-3">Distance</dt>
            <dd class="col-sm-9">@Model.Distance km</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Max Participants</dt>
            <dd class="col-sm-9">@Model.MaxParticipants</dd>
        </dl>

        <p class="mt-3">Are you sure you want to enrol in this event?</p>

        <form asp-action="EnrolConfirm" asp-route-eventId="@Model.EventID" method="post">
            @Html.AntiForgeryToken()
            <a asp-controller="Events" asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger ms-2">Confirm Enrolment</button>
        </form>
    </div>
</div>