@model List<RaceDay.MVC.Models.EnrolmentViewModel>
@{
    ViewData["Title"] = "My Enrolments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold">My Enrolments</h3>
    <a asp-controller="Events" asp-action="Index" class="btn btn-danger">Browse Events</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">You are not enrolled in any events yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Distance</th>
                    <th>Status</th>
                    <th>Enrolled On</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="fw-semibold">@e.EventName</td>
                        <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@e.Location</td>
                        <td>@e.Distance km</td>
                        <td>
                            <span class="badge @(e.Status == "Active" ? "bg-success" : "bg-secondary")">
                                @e.Status
                            </span>
                        </td>
                        <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (e.Status == "Active")
                            {
                                <form asp-action="Cancel" asp-route-id="@e.EnrolmentID" method="post" class="d-inline"
                                      onsubmit="return confirm('Cancel this enrolment?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}