@model RaceDay.MVC.Models.EventViewModel
@{
    ViewData["Title"] = Model.EventName;
    var role = Context.Session.GetString("Role");
}

<div class="card shadow-sm">
    <div class="card-header bg-dark text-white">
        <h4 class="mb-0"> @Model.EventName</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.EventDate.ToString("dd MMMM yyyy HH:mm")</dd>

            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@Model.Location</dd>

            <dt class="col-sm-3">Distance</dt>
            <dd class="col-sm-9">@Model.Distance km</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Status == "Open" ? "bg-success" : "bg-secondary")">@Model.Status</span>
            </dd>

            <dt class="col-sm-3">Max Participants</dt>
            <dd class="col-sm-9">@Model.MaxParticipants</dd>

            @if (!string.IsNullOrEmpty(Model.RouteDescription))
            {
                <dt class="col-sm-3">Route</dt>
                <dd class="col-sm-9">@Model.RouteDescription</dd>
            }
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Index" class="btn btn-secondary">Back</a>
        @if (role == "Participant" && Model.Status == "Open")
        {
            <a asp-controller="Enrolments" asp-action="Enrol" asp-route-eventId="@Model.EventID"
               class="btn btn-danger ms-2">Enrol in this Event</a>
        }
        @if (role == "Organiser")
        {
            <a asp-action="Edit" asp-route-id="@Model.EventID" class="btn btn-primary ms-2">Edit</a>
        }
    </div>
</div>